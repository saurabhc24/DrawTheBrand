{
  "name": "showreel",
  "version": "1.0.0",
  "description": "Brandr showreel — a Remotion motion piece built from the game's own design system",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/paths": "4.0.534",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.534",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "sync-logos": "node -e \"require('fs').cpSync('../public/logos','public/logos',{recursive:true})\"",
    "predev": "npm run sync-logos",
    "dev": "remotion studio",
    "render": "npm run sync-logos && remotion render Showreel out/brandr-showreel.mp4 --crf=16 --jpeg-quality=95",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  }
}
